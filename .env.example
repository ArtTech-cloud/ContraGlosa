ANTHROPIC_API_KEY=
AGENTE_MODELO=claude-haiku-5-5
# esforço do modelo: low | medium | high
AGENTE_ESFORCO=medium
# 1 = modo demo: só lê respostas do cache em cache/, sem internet
MODO_DEMO=0
# Segredo do token HMAC da carteira. DEIXE VAZIO na demo: o cache em cache/ foi gerado com o segredo
# padrão, e um segredo diferente muda os tokens e faz o modo demo não achar as respostas.
# Em uso real com dados de verdade, defina um segredo longo e próprio.
PSEUDONIMO_SEGREDO=
# Data de referência para os prazos (aaaa-mm-dd). Vazio = hoje.
AGENTE_HOJE=
